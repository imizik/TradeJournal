# Public TradingView webhook-only ingress. Copy this file to
# backend/.env.tradingview for local development. Never add private app API
# keys or unrestricted database credentials here.
# Start it through the repo launcher only when needed:
# TRADINGVIEW_INGRESS_ENABLED=true bash startdev.sh
#
# Generate a token with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
TRADINGVIEW_WEBHOOK_TOKEN=

# Leave blank only when both local processes use the default SQLite file. If
# the private app uses DATABASE_URL, point this at the same database. Production
# should use a role restricted to INSERT/SELECT on tradingview_alert. Run
# Alembic separately with privileged private credentials; the ingress never
# creates or migrates schema.
TRADINGVIEW_DATABASE_URL=
