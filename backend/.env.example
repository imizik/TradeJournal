# Private TradeJournal API worker.
# Background jobs: embedded (local default) or external (separate workers).
# External mode requires the SAME absolute local directory on one host for
# API and all workers. Keep it stable across releases; see docs/agent/background-jobs.md.
JOB_EXECUTION_MODE=embedded
JOB_LOCK_DIR=
#
# Copy to backend/.env. Everything here is OPTIONAL: with an empty file the
# app runs against local SQLite and every external integration stays dormant.
# The test suite ignores this file entirely (backend/tests/conftest.py pins a
# throwaway database), so tests never need credentials.
#
# Loaded in order: exported environment, then backend/.env, then repo-root
# .env. Exported values win. Keep the public TradingView ingress out of this
# file -- it reads only backend/.env.tradingview.

# ------------------------------------------------------------- environment --
# Display label only, reported by GET /health so you can tell a Neon dev
# branch from production at a glance: "dev" | "staging" | "production".
# It does NOT grant or withhold any permission -- destructive operations are
# gated on the live database identity, per-request. See
# docs/agent/environments.md.
APP_ENV=

# ---------------------------------------------------------------- database --
# Unset -> backend/data/trade_journal.db (SQLite). Neon/Postgres must use the
# psycopg SQLAlchemy driver form:
#   postgresql+psycopg://USER:PASSWORD@HOST/dbname?sslmode=require
# WARNING: this is a real database. Point it at a Neon branch, not production,
# when doing anything destructive (resync-all, rebuild-all).
# Migrations only. Set this when database roles are split: the application
# connects as a role that cannot create or drop anything, so DATABASE_URL is
# not usable for `alembic upgrade`. Unset, alembic uses DATABASE_URL.
# See docs/agent/environments.md.
MIGRATION_DATABASE_URL=

DATABASE_URL=

# ------------------------------------------------------------ market data --
# Polygon: option greeks, minute/hour/daily bars for fill enrichment.
# Without it, Polygon enrichment fields stay null (the UI shows them missing).
POLYGON_API_KEY=
# Enrichment call rate. Leave this unset: the enricher runs unpaced and learns
# the real budget from Polygon's first 429 (Basic allows 5/min; paid Stocks
# plans have no per-minute limit and so never pace). Set it only as a ceiling,
# to deliberately stay below what the plan allows. Setting it to 4.5 here is
# what made every copied .env crawl at free-tier speed regardless of plan.
# POLYGON_CALLS_PER_MINUTE=
# Alpaca: fill market context, live quotes, news, scalp packets.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# iex (free) or sip (paid).
ALPACA_DATA_FEED=iex
# indicative (default) or opra.
ALPACA_OPTIONS_FEED=indicative

# Live quotes for open positions and the daily page: yfinance (default) or
# tradier. yfinance is unofficial and unlicensed and downloads a whole option
# chain to read one contract; tradier is licensed, consolidated, and batches
# every position into one request. Tradier falls back to yfinance on any error,
# so a bad token degrades rather than blanking the dashboard.
# Measure before switching: backend/scripts/compare_quote_providers.py.
QUOTES_PROVIDER=yfinance
# Tradier: live stock and option quotes. Real-time data is production-only and
# requires a Tradier Brokerage account; the sandbox host is 15 minutes delayed
# and serves no greeks. Token from the Tradier settings page; it does not
# expire. Used ONLY for live quotes -- historical enrichment stays on Polygon
# and Alpaca (docs/tradier-integration-plan.md explains why).
TRADIER_API_KEY=
# https://api.tradier.com (default). Point at https://sandbox.tradier.com only
# to test request shapes -- delayed data and no greeks make it useless for
# anything else.
TRADIER_BASE_URL=
# Black-Scholes discount rate used for greeks.
RISK_FREE_RATE=0.0372

# ------------------------------------------------------------- ai reviews --
# Required only for trade review and daily review.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ------------------------------------------------------- gmail fill ingest --
# OAuth uses backend/credentials.json and writes backend/token.json; neither is
# an environment variable. These control the Pub/Sub push path only.
# Public URLs used to build OAuth redirect and CORS targets.
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000
# projects/<project>/topics/<topic>
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_VERIFICATION_TOKEN=
# Re-register the Gmail watch on a timer instead of by hand. Watches expire.
# Ignored when GMAIL_LISTENER_ENABLED is on: the listener owns renewal.
GMAIL_WATCH_AUTOSTART=false
# Label names or ids to watch, comma separated. GMAIL_WATCH_LABEL_IDS is the
# older spelling and is still read when this is unset.
GMAIL_WATCH_LABELS=INBOX
GMAIL_WATCH_RENEW_SECONDS=86400
# Real-time import through a Pub/Sub *pull* subscription (nothing inbound).
# Only one machine may listen: leave this off on a laptop that shares the
# production database or subscription with the VPS.
GMAIL_LISTENER_ENABLED=false
# projects/<project>/subscriptions/<subscription>
GMAIL_PUBSUB_SUBSCRIPTION=
# Service-account key with Pub/Sub Subscriber on that subscription only.
# Defaults to backend/pubsub-subscriber.json.
GMAIL_PUBSUB_CREDENTIALS_FILE=

# ------------------------------------------------------------------ webull --
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCESS_TOKEN=
WEBULL_API_BASE=
WEBULL_EVENTS_HOST=
WEBULL_ENVIRONMENT=prod
WEBULL_REGION=us
WEBULL_REGION_ID=
# Start the gRPC trade-event listener on boot. Off by default: it is a
# persistent listener, not a finite sync job.
WEBULL_LISTENER_AUTOSTART=false
# Comma-separated account ids. Wins over scanning the local database.
WEBULL_LISTENER_ACCOUNTS=
WEBULL_ALLOW_TEST_INGEST=true

# ------------------------------------------- tradingview analysis worker ----
# The webhook TOKEN and the ingress database URL live in
# backend/.env.tradingview, not here. These tune the private-side worker that
# analyzes alerts already in the database.
TRADINGVIEW_ANALYSIS_AUTOSTART=false
TRADINGVIEW_ANALYSIS_MAX_ATTEMPTS=3
TRADINGVIEW_ANALYSIS_RETRY_SECONDS=60
TRADINGVIEW_ANALYSIS_LEASE_SECONDS=900
TRADINGVIEW_ANALYSIS_POLL_SECONDS=1
TRADINGVIEW_ALERT_MAX_AGE_SECONDS=1800
TRADINGVIEW_ALERT_MAX_FUTURE_SKEW_SECONDS=120

# --------------------------------------------------------------------- mcp --
# backend/mcp_server.py talks to the private API over HTTP. Set this when the
# backend is on 8080 (startdev default) rather than 8000.
TRADE_JOURNAL_API=http://localhost:8000
