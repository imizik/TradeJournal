# Private TradeJournal API worker. Keep public webhook credentials in the
# separate .env.tradingview file; this process does not need that token.
TRADINGVIEW_ANALYSIS_AUTOSTART=false

TRADINGVIEW_ANALYSIS_MAX_ATTEMPTS=3
TRADINGVIEW_ANALYSIS_RETRY_SECONDS=60
TRADINGVIEW_ANALYSIS_LEASE_SECONDS=900
TRADINGVIEW_ANALYSIS_POLL_SECONDS=1
TRADINGVIEW_ALERT_MAX_AGE_SECONDS=1800
TRADINGVIEW_ALERT_MAX_FUTURE_SKEW_SECONDS=120
