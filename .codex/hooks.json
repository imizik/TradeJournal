{
  "description": "Return pending independent reviews to the owning Codex session.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/pr_review.py\" hook --owner codex", "timeout": 10}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/pr_review.py\" hook --owner codex", "timeout": 10}]}]
  }
}
