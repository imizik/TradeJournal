[Unit]
Description=Unix ingress for the isolated pre-trade check MCP (manual activation)

[Socket]
ListenStream=/run/tradejournal-check/mcp.sock
SocketUser=tj-check
SocketGroup=caddy
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true
Accept=no

# Deliberately no Install section: installed disabled, never boot-activated.
