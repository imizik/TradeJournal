# Disabled proposal, never included in normal deployment. Replace this reserved
# hostname with the EXACT approved resource origin; validate before publication.
check.example.test {
    @check_mcp {
        path /check/mcp
        method GET POST DELETE OPTIONS
    }
    @check_metadata {
        path /.well-known/oauth-protected-resource/check/mcp
        method GET HEAD
    }
    handle @check_mcp {
        request_body {
            max_size 64KB
        }
        reverse_proxy unix//run/tradejournal-check/mcp.sock {
            flush_interval -1
            transport http {
                dial_timeout 3s
                response_header_timeout 15s
            }
        }
    }
    handle @check_metadata {
        reverse_proxy unix//run/tradejournal-check/mcp.sock {
            transport http {
                dial_timeout 3s
                response_header_timeout 15s
            }
        }
    }
    handle {
        respond 404
    }
}
