[Unit]
Description=Private owner reader socket for saved pre-trade checks; never public

[Socket]
ListenStream=/run/tradejournal-check-owner/owner.sock
SocketUser=root
SocketGroup=tj-advisor-web-owner
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true
Service=tradejournal-check-owner.service

# No Install section: no automatic start or boot enablement.
