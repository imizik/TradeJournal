[Unit]
Description=Private journal reader socket for saved pre-trade checks; never public

[Socket]
ListenStream=/run/tradejournal-check-journal/owner.sock
SocketUser=root
# Only the private journal's account; the advisor trial keeps its own socket and group.
SocketGroup=tradejournal
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true
Service=tradejournal-check-journal.service

# No Install section: no automatic start or boot enablement.
