# Root-owned /etc/tradejournal/backend.env, mode 0600. No shell interpolation.
# Use the application role; both Neon and later local Postgres use this setting.
DATABASE_URL=postgresql+psycopg://APP_USER:PASSWORD@DATABASE_HOST/DATABASE?sslmode=require
APP_ENV=production
# Replace this with the private Tailscale Serve origin. Register the full
# BACKEND_PUBLIC_URL + /auth/gmail/callback URI in the Google OAuth client.
FRONTEND_PUBLIC_URL=https://YOUR_SERVER.YOUR_TAILNET.ts.net
BACKEND_PUBLIC_URL=https://YOUR_SERVER.YOUR_TAILNET.ts.net/api/backend

# Copy only the private integration settings you use from backend/.env.example.
# Runtime enforces external workers and a stable lock path.
WEBULL_LISTENER_AUTOSTART=false
GMAIL_WATCH_AUTOSTART=false
# Real-time Gmail import (deploy/README.md, "Real-time Gmail import"). Off until
# the Pub/Sub topic, pull subscription, label and key exist. The listener owns
# watch renewal; keep GMAIL_WATCH_AUTOSTART=false.
GMAIL_LISTENER_ENABLED=false
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=
GMAIL_PUBSUB_CREDENTIALS_FILE=/var/lib/tradejournal/oauth/pubsub-subscriber.json
GMAIL_WATCH_LABELS=TradeJournal/Fills
TRADINGVIEW_ANALYSIS_AUTOSTART=false
WEBULL_ALLOW_TEST_INGEST=false
POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ANTHROPIC_API_KEY=
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
