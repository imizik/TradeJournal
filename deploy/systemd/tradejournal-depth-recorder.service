[Unit]
Description=TradeJournal opt-in moomoo depth recorder for a short watchlist
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tradejournal-moomoo
Group=tradejournal-moomoo
WorkingDirectory=/opt/tradejournal/current/backend
# Optional: TJ_DEPTH_TICKERS=SPY,MU,NBIS,SNDK,NVDA (the default when absent).
EnvironmentFile=-/etc/tradejournal/depth-recorder.env
LoadCredential=appkey:/etc/tradejournal/moomoo/appkey
LoadCredential=phase1-ed25519.pem:/etc/tradejournal/moomoo/phase1-ed25519.pem
StateDirectory=tradejournal-depth
StateDirectoryMode=0750
ExecStartPre=/opt/tradejournal/current/backend/.venv/bin/python -c "from scripts.moomoo_lab_server import check_credentials; check_credentials()"
ExecStart=/opt/tradejournal/current/backend/.venv/bin/python -m scripts.moomoo_depth_recorder
Restart=on-failure
RestartSec=30
TimeoutStopSec=15
KillMode=control-group
UMask=0027
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
InaccessiblePaths=-/var/lib/tradejournal -/etc/tradejournal
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
