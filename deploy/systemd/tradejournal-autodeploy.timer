[Unit]
Description=Check for a verified TradeJournal build every three minutes

[Timer]
# Not faster: the check is unauthenticated (60 GitHub calls an hour), and a
# build held for market hours costs two calls a pass -- 40 an hour at this rate.
OnCalendar=*:0/3
RandomizedDelaySec=30
Unit=tradejournal-autodeploy.service

[Install]
WantedBy=timers.target
