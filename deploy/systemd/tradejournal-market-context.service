[Unit]
Description=Queue the earnings and VIX refresh for the pre-trade check
Wants=network-online.target tradejournal-api.service tradejournal-worker@sync.service
After=network-online.target tradejournal-api.service tradejournal-worker@sync.service

[Service]
EnvironmentFile=-/etc/tradejournal/access-automation.env
Type=oneshot
User=tradejournal
Group=tradejournal
WorkingDirectory=/opt/tradejournal/current/backend
ExecStart=/opt/tradejournal/current/backend/.venv/bin/python /opt/tradejournal/current/deploy/automation.py market-context
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tradejournal
