[Unit]
Description=Opt-in nightly TradeJournal daily reviews through the Anthropic API
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=tradejournal
Group=tradejournal
WorkingDirectory=/opt/tradejournal/current/backend
EnvironmentFile=/etc/tradejournal/backend.env
Environment=TJ_PLAN_REVIEW_DIR=/var/lib/tradejournal/plan-reviews
Environment=HOME=/var/lib/tradejournal
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/tradejournal/current/backend/.venv/bin/python -m app.jobs.plan_reviews
TimeoutStartSec=90min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tradejournal
