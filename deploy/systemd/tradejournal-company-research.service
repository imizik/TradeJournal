[Unit]
Description=Queue the approved Company Research daily refresh
Wants=network-online.target tradejournal-worker@sync.service
After=network-online.target tradejournal-worker@sync.service

[Service]
Type=oneshot
User=tradejournal
Group=tradejournal
WorkingDirectory=/opt/tradejournal/current/backend
EnvironmentFile=/etc/tradejournal/backend.env
ExecStart=/opt/tradejournal/current/backend/.venv/bin/python -m app.jobs.company_research --daily
TimeoutStartSec=2min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tradejournal
