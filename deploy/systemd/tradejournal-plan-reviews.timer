[Unit]
Description=Opt-in nightly daily reviews on the Claude plan at 20:10 New York

[Timer]
# After the 17:00 Sync Everything, its enrichment, the 19:20 options catch-up and 20:05, when the day's minute bars are final.
OnCalendar=*-*-* 20:10:00 America/New_York
RandomizedDelaySec=120
Persistent=true
Unit=tradejournal-plan-reviews.service

[Install]
WantedBy=timers.target
