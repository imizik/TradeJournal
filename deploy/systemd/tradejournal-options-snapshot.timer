[Unit]
Description=Keep the day's option open interest and volume after the close (16:20, catch-up 19:20 New York)

[Timer]
OnCalendar=Mon..Fri *-*-* 16:20:00 America/New_York
OnCalendar=Mon..Fri *-*-* 19:20:00 America/New_York
RandomizedDelaySec=60
Persistent=true
Unit=tradejournal-options-snapshot.service

[Install]
WantedBy=timers.target
