[Unit]
Description=Queue the TradeJournal Sync Everything pipeline
Wants=network-online.target tradejournal-api.service tradejournal-worker@sync.service
After=network-online.target tradejournal-api.service tradejournal-worker@sync.service

[Service]
Type=oneshot
User=tradejournal
Group=tradejournal
WorkingDirectory=/opt/tradejournal/current/backend
ExecStart=/opt/tradejournal/current/backend/.venv/bin/python /opt/tradejournal/current/deploy/automation.py sync-pipeline
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tradejournal
