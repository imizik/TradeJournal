[Unit]
Description=Constrain only the journal maintenance publisher network identities
Before=tradejournal-journal-export.service tradejournal-journal-real-keys.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/tradejournal-journal-real/publisher-network.nft
ExecStop=/usr/sbin/nft delete table inet tj_journal_publishers
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_NETLINK AF_UNIX
SystemCallArchitectures=native
TasksMax=8
MemoryMax=128M
TimeoutStartSec=15

# A manually installed policy affects only the two dedicated publisher UIDs.
# Never flush the host ruleset. Publishers require this unit to start successfully.
