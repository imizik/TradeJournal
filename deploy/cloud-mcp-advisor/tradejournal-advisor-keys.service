[Unit]
Description=Refresh only public OAuth keys for the advisor entrance
Wants=network-online.target
Requires=tradejournal-advisor-keys-network.service
After=network-online.target tradejournal-advisor-keys-network.service

[Service]
Type=oneshot
User=tj-advisor-keys
Group=tj-advisor
WorkingDirectory=/var/lib/tradejournal-advisor-v2-keys
Environment=PYTHON_DOTENV_DISABLED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/tradejournal-advisor-v2/adapter
ExecStart=/opt/tradejournal-advisor-v2/adapter/.venv/bin/python -B /opt/tradejournal-advisor-v2-keys/cloud_mcp_d0_refresh.py --config /etc/tradejournal-advisor-v2-keys/refresh-keys.json
TimeoutStartSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ReadWritePaths=/var/lib/tradejournal-advisor-v2-keys
InaccessiblePaths=-/etc/tradejournal-advisor-v2/advisor -/etc/tradejournal-advisor-v2/owner -/etc/tradejournal-advisor-v2/frontend.env -/var/lib/tradejournal-advisor-v2 -/run/tradejournal-advisor-v2 -/run/tradejournal-advisor-owner-v2 -/opt/tradejournal-advisor-v2/backend -/opt/tradejournal-advisor-v2/frontend -/opt/tradejournal-advisor-v2/operator -/opt/tradejournal-advisor-v2/recovery -/etc/tradejournal-advisor -/var/lib/tradejournal-advisor -/run/tradejournal-advisor -/etc/tradejournal -/etc/tradejournal-d0 -/etc/tradejournal-d1 -/etc/tradejournal-journal -/etc/tradejournal-journal-real -/etc/tradejournal-dot-trial -/opt/tradejournal -/opt/tradejournal-journal -/opt/tradejournal-journal-real -/var/lib/tradejournal -/var/lib/tradejournal-journal -/var/lib/tradejournal-journal-real -/var/backups/tradejournal -/run/dbus -/run/docker.sock -/run/containerd -/run/podman
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
TasksMax=16
MemoryMax=256M
CPUQuota=50%

# Separate public-key publisher: no advisor config, grants, fixture, sockets or
# database. Writes only the public snapshot directory the advisor reads.
