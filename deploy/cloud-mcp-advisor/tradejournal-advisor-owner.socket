[Unit]
Description=Optional private advisor owner reader; never public

[Socket]
ListenStream=/run/tradejournal-advisor-owner/owner.sock
SocketUser=root
SocketGroup=tradejournal
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true
Service=tradejournal-advisor-owner.service

# No Install section: no automatic start or boot enablement.
