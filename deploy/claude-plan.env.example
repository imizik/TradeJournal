# Root-owned /etc/tradejournal/claude-plan.env, mode 0600. No shell interpolation.
# The Claude plan token for the nightly daily reviews and the Daily Review
# button: run `claude setup-token` on a computer with a browser, signed in to
# the plan, and paste the token here. Never an API key: the reviews refuse any
# sign-in other than this token.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: the model (sonnet), seconds per review (300),
# and the API-price ceiling per review Claude Code enforces should a call ever
# bill an API key (2).
#TJ_PLAN_REVIEW_MODEL=sonnet
#TJ_PLAN_REVIEW_TIMEOUT=300
#TJ_PLAN_REVIEW_BUDGET_USD=2
