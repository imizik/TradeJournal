[Unit]
Description=Private Unix bridge for approved sample MCP reads (manual trial only)

[Socket]
ListenStream=/run/tradejournal-d1/reads.sock
SocketUser=tradejournal-d0
SocketGroup=tradejournal-d0
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true
Accept=no

# No Install section: start manually only after approving the sample grant.
