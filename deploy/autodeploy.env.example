# Root-owned 0600 at /etc/tradejournal/autodeploy.env. Creating this file is
# what turns automatic deployment on; see deploy/README.md.
AUTODEPLOY_ENABLED=true
AUTODEPLOY_REPOSITORY=OWNER/REPOSITORY
# The exact identity printed by: sudo tradejournal-deploy identity RELEASE_ID
AUTODEPLOY_CONFIRM_DATABASE=127.0.0.1:5432/tradejournal
# New York time, weekdays. A build merged in this window waits for its end
# unless its pull request has the deploy-now label. Use off to deploy anytime.
AUTODEPLOY_HOLD_WINDOW=09:25-16:15
# Newest installed releases to keep, about 1 GB each. The current and
# previous releases are always kept as well.
AUTODEPLOY_KEEP_RELEASES=3
# Deploys, holds and failures go to the phone-alerts topic in alerts.env.
# Set an ntfy topic URL here only to send them somewhere else.
NTFY_URL=
