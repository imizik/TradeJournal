# Root-owned /etc/tradejournal/alerts.env, mode 0600. Phone alerts stay off
# until this file exists (deploy/README.md, "Phone alerts").
# The ntfy server and topic. Anyone who knows a topic on ntfy.sh can read it,
# so use a long random name and subscribe to it in the ntfy phone app.
NTFY_URL=https://ntfy.sh/tradejournal-REPLACE-WITH-A-LONG-RANDOM-STRING
# Optional access token for a protected topic or a self-hosted server.
NTFY_TOKEN=
# Optional: use the server's fixed IPv4 address for notifications. Useful when
# the host shares an IPv6 /64 with other tenants and ntfy counts their usage too.
NTFY_IPV4_ONLY=false
# Tapping a notification opens this address: the private Tailscale origin.
ALERT_APP_URL=https://YOUR_SERVER.YOUR_TAILNET.ts.net
# Optional dead-man's switch, pinged after every check (e.g. a healthchecks.io
# check URL). It alerts from outside when the server stops checking in.
HEALTHCHECK_PING_URL=
# Optional: alert when Jo's scheduled morning brief misses its deadline or its
# publication/import stalls. Off unless true.
JO_MORNING_ALERTS=false

# Optional: alert when one of Jo's scheduled market reads (9:50, 11:00, 12:30,
# 2:00 ET) has no read 15 minutes after its slot, or the app stops checking for
# reads. Needs MARKET_WATCH_ENABLED in backend.env. Off unless true.
JO_MARKET_READ_ALERTS=false

# Optional open-position phone alerts. Leave false until explicitly activated.
POSITION_ALERTS_ENABLED=false
# Optional: only this account's SPY/QQQ long options may arm at +10% without
# the normal +$50 gain floor. Copy the account UUID only after verifying the
# intended database with GET /health and matching its Roth IRA entry in GET /accounts.
# Keep the real UUID in the private server config; never commit it here.
POSITION_ALERTS_FLOORLESS_ACCOUNT_ID=
